# Copy to apps/web/.env.local (gitignored). Values come from cdk-outputs.json after `pnpm deploy:infra`.
VITE_API_URL=https://xxxxxxxxxx.execute-api.us-east-1.amazonaws.com
# Dev only: the TV's pairing QR points the phone at the HTTPS dev server (camera needs a secure context).
VITE_PHONE_ORIGIN=https://192.168.1.20:5174

# Used by `pnpm deploy:infra` to allow your laptop's Vite dev server through API Gateway CORS.
# Remove for the production deploy.
DEV_ORIGINS=http://192.168.1.20:5173,https://192.168.1.20:5174

# AWS: use a named profile, never commit keys.
AWS_PROFILE=firefit
AWS_REGION=us-east-1

# Bedrock model the coach agent reasons with (cross-region inference profile id).
MODEL_ID=us.amazon.nova-2-lite-v1:0
